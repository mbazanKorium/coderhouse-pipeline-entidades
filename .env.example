# Proveedor: openai | anthropic
LLM_PROVIDER=openai

# Modelo (opcional; por defecto gpt-4.1-mini / claude-haiku-5-5)
# LLM_MODEL=gpt-4.1-mini

# Límite de tokens de respuesta e intentos totales de la cadena
LLM_MAX_TOKENS=1024
LLM_MAX_INTENTOS=3

# Solo hace falta la clave del proveedor elegido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
